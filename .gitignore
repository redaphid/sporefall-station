node_modules/
dist/
outputs/
e2e/output*/
android/app/build/
android/.gradle/
android/build/
android/local.properties
*.log
pnpm-lock.yaml
.claude/worktrees/

# Android release signing — NEVER commit keystores or their passwords.
android/keystore.properties
keystore.properties
*.keystore
*.jks
*.p12
*.pkcs12

__pycache__/
*.pyc
.observer/
.gm/

# Cloudflare Workers local dev/build cache (wrangler dev, wrangler deploy).
.wrangler/

# transient art sweep staging (never committed)
.art-stage/

# Generated A/B baseline for the tween harness (see tools/tween/make-baseline.sh)
tools/tween/baseline/
tools/tween/*.csv
tools/tween/figure.svg

# Throwaway candidate-review theme packs (scripts/assets/build_review_themes.py).
# Rebuildable from a sweep; never shipped.
public/themes/_review-*/
# Packs are named `review-*`, NOT `_review-*`: a theme id must match
# /^[a-z0-9][a-z0-9-]*$/, so a leading underscore makes the id invalid and the
# loader silently serves the DEFAULT pack instead of the candidate. The old
# `_review-*` line stays so leftover dirs from that era remain ignored.
public/themes/review-*/
