{
  "name": "backseat",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "build:apk": "bash scripts/build-apk.sh",
    "build:apk:release": "bash scripts/build-apk.sh --release",
    "dev:live": "bash scripts/dev-live.sh",
    "install:apk": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "e2e": "./e2e/run.sh",
    "e2e:play": "node e2e/play-session.mjs",
    "e2e:showcase": "node e2e/record-showcase.mjs",
    "test:e2e:fire": "bash e2e/run-fire.sh",
    "test:e2e:weapons": "bash e2e/run-weapons.sh",
    "test:e2e:frost": "bash e2e/run-frost.sh",
    "test:e2e:items": "bash e2e/run-items.sh",
    "test:e2e:rel": "bash e2e/run-rel.sh",
    "test:e2e:ai": "bash e2e/run-ai.sh",
    "test:e2e:obj": "bash e2e/run-obj.sh",
    "e2e:features": "bash e2e/run-features.sh",
    "e2e:comm-ui": "bash e2e/run-comm-ui.sh",
    "e2e:feature:combat": "bash e2e/run-features.sh combat",
    "e2e:feature:fire": "bash e2e/run-features.sh fire",
    "gen:fixtures": "tsx scripts/test/gen-serialize-fixtures.mts && tsx scripts/test/gen-feature-fixtures.mts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capgo/capacitor-bluetooth-low-energy": "^8.2.0",
    "@capgo/capacitor-updater": "^8.51.0",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.6.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  }
}
