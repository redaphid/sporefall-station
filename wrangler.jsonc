{
  // Cloudflare WORKERS config (migrated from Pages). One Worker serves the static
  // game AND hosts the WebSocket multiplayer relay (a Durable Object) on the same
  // origin — no CORS, one deploy. See docs/deploy.md.
  //
  //   local:   npx wrangler dev            (http://localhost:8787)
  //   deploy:  npx wrangler deploy         (CI does this on push to main)
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sporefall-station",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-04-07",

  // Canonical public origin. Attaches sporefall.hypnodroid.com to this Worker on
  // deploy (the zone must live in this Cloudflare account). The free
  // *.workers.dev origin keeps working alongside it.
  "routes": [{ "pattern": "sporefall.hypnodroid.com", "custom_domain": true }],

  // Version preview URLs, which is the whole point of preview-web.yml. That
  // workflow uploads a version per `preview/**` branch so risky work can be
  // judged from a URL before it reaches the live game — but the uploads were
  // landing with previews_enabled=false on the Worker, so the
  // https://<version-prefix>-sporefall-station.loqwai.workers.dev address the
  // workflow advertises answered 404 and there was nothing to review.
  //
  // This does NOT put production on workers.dev: `workers_dev` stays unset, so
  // sporefall-station.loqwai.workers.dev keeps 404ing and sporefall.hypnodroid.com
  // remains the only live origin. Only the per-version preview addresses resolve.
  //
  // NOT SUFFICIENT ON ITS OWN — this key is necessary but does not take effect
  // from the preview workflow. Subdomain settings are applied by `wrangler
  // deploy`; `wrangler versions upload` (all preview-web.yml runs) does not push
  // them, so after a preview upload the API still reports:
  //     {"enabled": false, "previews_enabled": false}
  // Turning previews on for real is an account-side flip on the SCRIPT's
  // workers.dev subdomain, and enabling that subdomain is what would also expose
  // production at sporefall-station.loqwai.workers.dev — an exposure change, so
  // it is deliberately left for the owner rather than done from a branch.
  //
  // AND IT STILL WOULD NOT HELP: *.workers.dev on this account is covered by a
  // wildcard Cloudflare Access app, so every version preview URL 302s to the
  // Access login page. Per-branch review now goes through /betas/<slug>/ instead
  // (src/worker/betas.ts), which needs none of this. The key is left set because
  // it is harmless and the reasoning above is worth keeping.
  "preview_urls": true,

  // Serve the Vite build. Only the Worker routes below run the Worker; every
  // other path is served straight from these assets (free, cached). public/_headers
  // and public/_redirects (copied into dist/ by Vite) are honored, including the SPA
  // fallback and the /download APK short-links.
  //
  // /review/* MUST stay in run_worker_first: `not_found_handling` below answers any
  // other unknown path with 200 + index.html, which would turn a missing review
  // image into a healthy-looking 200 that still renders broken.
  //
  // /betas and /betas/* MUST stay in it for a worse version of the same reason.
  // A beta build lives in KV (src/worker/betas.ts), so every path under it is
  // "unknown" to this assets directory — without the entry, the SPA fallback
  // would answer /betas/<slug>/ with 200 + PRODUCTION's index.html, which loads
  // PRODUCTION's hashed /assets/*.js. The reviewer would be judging the live
  // game while the URL told him it was the branch. Both entries are needed:
  // the bare /betas (the index page) is not matched by /betas/*.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*", "/ota/*", "/review/*", "/state", "/state/*", "/betas", "/betas/*"]
  },

  // Before/after images referenced from PR bodies (src/worker/reviewImages.ts).
  // A separate namespace on purpose: these are review artefacts, so they stay out
  // of the repo, out of dist/, and out of the APK. Publish with
  // `pnpm run review:image <file>` — an upload, not a deploy.
  //
  // WORLDS holds serialized worlds (src/worker/worldStore.ts). Today the only
  // writer is the `?state=<id>` debug link a player sends a friend to reproduce
  // an exact world, but the binding is named for the PAYLOAD rather than that one
  // caller: a saved game or a hand-built level is the same blob behind the same
  // kind of opaque id. KV keys are `world:<id>`, so a `save:`/`level:` neighbour
  // could share the namespace without a migration. Separate from REVIEW_IMAGES on
  // purpose — 30-day TTL vs permanent, written by the running game rather than a
  // local script, and independently purgeable.
  //
  // The namespace exists on the account titled `sporefall-worlds` (project-scoped,
  // matching the other namespaces there). The namespace TITLE and this BINDING
  // name are different things and need not match.
  //
  // VERIFIED: `wrangler kv key list --binding WORLDS --remote` resolves this id
  // against the live account and returns a real (empty) listing. A remote WRITE
  // is verified too as of the betas work: the wrangler OAuth session DOES carry
  // `workers_kv (write)` (check with `wrangler whoami`), which is what lets
  // `pnpm run beta:publish` put a whole bundle from a laptop or from CI without
  // a deploy. An earlier note here claimed the opposite; it was wrong.
  // `wrangler dev` (without --remote) never touches any of this; it simulates KV
  // locally and ignores the id, so a wrong id could only surface at upload,
  // loudly, as an unknown-namespace error.
  //
  // BETAS holds per-branch beta BUILDS served at /betas/<slug>/
  // (src/worker/betas.ts). Keys are `b/<slug>/<file path>` for the bytes and
  // `i/<slug>` for the listing entry that /betas/ renders. Written by
  // `pnpm run beta:publish` (an UPLOAD, not a deploy — same model as
  // review:image, which is what lets a beta go live before its PR merges).
  // Its own namespace rather than a prefix on REVIEW_IMAGES because it holds a
  // whole `dist/` per branch and is meant to be purged wholesale; doing that to
  // REVIEW_IMAGES would break every published PR body.
  //
  // The namespace exists on the account titled `sporefall-betas`.
  "kv_namespaces": [
    { "binding": "REVIEW_IMAGES", "id": "bf1d248ccc644174b788c6e5ec97c476" },
    { "binding": "WORLDS", "id": "e58c5059c7484ad28610e093d9870e01" },
    { "binding": "BETAS", "id": "2f37fd0f66124e69bf38c92a953f9131" },
  ],

  // One Durable Object instance per multiplayer room. SQLite-backed class (the
  // current default for new DOs); the relay itself stores nothing, but SQLite
  // classes are required for new_sqlite_classes migrations.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],

  "observability": { "enabled": true }
}
