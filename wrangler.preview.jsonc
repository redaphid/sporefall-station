{
  // PREVIEW Worker — a SEPARATE, INDEPENDENT deployment, not a preview *of*
  // production. Production (`wrangler.jsonc`, Worker `sporefall-station`) is not
  // read, not modified, and not touched by anything in this file.
  //
  //   deploy:  npx wrangler deploy -c wrangler.preview.jsonc
  //   remove:  npx wrangler delete -c wrangler.preview.jsonc
  //
  // Why a second Worker instead of `wrangler versions upload`: uploading a
  // version to production shifts NO traffic, and production has
  // `previews_enabled: false` with no workers.dev subdomain of its own, so there
  // is no origin to serve a preview from — every such URL 404s while CI reports
  // success. A separate Worker has its own origin and sidesteps that entirely.
  "$schema": "./node_modules/wrangler/config-schema.json",

  // DIFFERENT NAME = different Worker. This is the whole isolation story: nothing
  // here can resolve to the `sporefall-station` script.
  "name": "sporefall-preview",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-04-07",

  // Its OWN hostname — a sibling of production's, never production's own.
  // `sporefall.hypnodroid.com` stays attached to `sporefall-station` and is not
  // read or rewritten by this file. Removing this Worker removes only this name.
  //
  // Why a custom domain at all, when workers_dev is on: this account protects
  // `*.loqwai.workers.dev` with Cloudflare Access, so the workers.dev URL answers
  // 302 -> loqwai.cloudflareaccess.com for a signed-out phone. A custom hostname
  // on this zone is public, exactly as production's already is.
  //
  // THIRD level, not fourth: Universal SSL on a Free plan covers `*.hypnodroid.com`
  // but NOT `*.sporefall.hypnodroid.com`, so `preview.sporefall.hypnodroid.com`
  // would fail TLS on a phone. Every other Worker on this zone is third-level too.
  //
  // This does NOT touch the APK's OTA channel: `capacitor.config.ts` bakes
  // OTA_UPDATE_URL at BUILD time, defaulting to sporefall.hypnodroid.com, so an
  // installed APK never resolves this hostname. `/ota/check` here reads only this
  // Worker's own assets.
  "routes": [{ "pattern": "sporefall-preview.hypnodroid.com", "custom_domain": true }],

  // The free workers.dev origin stays on as a fallback (Access-gated, so it is
  // useful for a signed-in desktop, not for a signed-out phone). Setting this on
  // THIS Worker says nothing about production's exposure — it is per-Worker, and
  // production's `enabled` is false and stays false.
  "workers_dev": true,

  // Same Vite build as production. `not_found_handling` means every unknown path
  // returns index.html with HTTP 200 — so a 200 here is NOT evidence a file
  // exists. Verify a deploy by fetching the hashed JS bundle and checking the
  // content-type, never by checking the root's status code.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*", "/ota/*"]
  },

  // The Worker entry exports RoomDO, so the binding is required for the script to
  // load at all. Durable Object namespaces are per-SCRIPT: this creates a fresh,
  // empty namespace. Preview multiplayer rooms are therefore NOT shared with
  // production — same room name on both origins is two unrelated rooms.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],

  "observability": { "enabled": true }
}
